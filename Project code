  local maxf maxd wwf wwd
  maxf=$(ini_get SCAN MaxWorldWritableFiles "$POLICY_FILE"); [ -z "$maxf" ] && maxf=50
  maxd=$(ini_get SCAN MaxWorldWritableDirs "$POLICY_FILE"); [ -z "$maxd" ] && maxd=50

  wwf=$(eval find / $FIND_PRUNE -type f -perm -0002 2>/dev/null | wc -l | tr -d ' ')
  wwd=$(eval find / $FIND_PRUNE -type d -perm -0002 2>/dev/null | wc -l | tr -d ' ')
  [ "$wwf" -gt "$maxf" ] && score=$((score-15))
  [ "$wwd" -gt "$maxd" ] && score=$((score-15))

  local ssh_note="" w_prl="" w_pa="" c_prl="" c_pa=""
  if ssh_installed; then
    w_prl=$(ini_get SSH PermitRootLogin "$POLICY_FILE"); [ -z "$w_prl" ] && w_prl=no
    w_pa=$(ini_get SSH PasswordAuthentication "$POLICY_FILE"); [ -z "$w_pa" ] && w_pa=no
    c_prl=$(sshd_get PermitRootLogin); [ -z "$c_prl" ] && c_prl="(not set)"
    c_pa=$(sshd_get PasswordAuthentication); [ -z "$c_pa" ] && c_pa="(not set)"
    [ "$(echo "$c_prl"|tr A-Z a-z)" != "$(echo "$w_prl"|tr A-Z a-z)" ] && score=$((score-20))
    [ "$(echo "$c_pa"|tr A-Z a-z)" != "$(echo "$w_pa"|tr A-Z a-z)" ] && score=$((score-20))
  else
    ssh_note="SSH NOT installed -> SSH checks are N/A (no scoring penalty)"
  fi
  [ "$score" -lt 0 ] && score=0

  {
    echo "Project: SentinelShield v1.1"
    echo "Purpose: Linux Security Audit & Hardening Framework"
    echo "Approach: Detect → Validate → Harden → Verify → Report"
    echo "Generated: $(date)"
    echo "Host: $(hostname)"
    echo "Policy: $POLICY_FILE"
    echo "Log: $LOGFILE"
    echo "------------------------------------------------------------"
    echo

    echo "[1] Permissions (REAL FS only)"
    echo "World-writable files: $wwf (max $maxf)"
    echo "World-writable dirs : $wwd (max $maxd)"
    echo

    echo "[2] SSH Security"
    if ssh_installed; then
      echo "SSH installed: YES | Service: $(ssh_status)"
      echo "Rule: Unset SSH options are NON-COMPLIANT (FAIL)"
      echo "PermitRootLogin        : Current=$c_prl | Policy=$w_prl"
      echo "PasswordAuthentication : Current=$c_pa  | Policy=$w_pa"
    else
      echo "SSH installed: NO"
      echo "$ssh_note"
      echo "Install:"
      echo "  sudo apt install openssh-server"
      echo "  sudo systemctl enable --now ssh"
    fi
    echo

    echo "[3] Ports (top 60)"
    if have ss; then ss -tulpen 2>/dev/null | head -n 60
    elif have netstat; then netstat -tulpen 2>/dev/null | head -n 60
    else echo "No ss/netstat."; fi
    echo

    echo "[4] SUID/SGID (top 40)"
    eval find / $FIND_PRUNE -type f \( -perm -4000 -o -perm -2000 \) 2>/dev/null | head -n 40
    echo

    echo "[5] Services (top 25)"
    systemctl list-units --type=service --state=running 2>/dev/null | head -n 25 || true
    echo
    echo "=== FINAL SCORE: $score / 100 ==="
  } >"$rep"

  log "Report $rep score=$score"
  msg "Report Generated" "Saved:\n$rep\n\nLog:\n$LOGFILE"
}

