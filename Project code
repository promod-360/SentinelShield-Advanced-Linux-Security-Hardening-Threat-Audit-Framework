    echo "$(status_line)"
    echo
    echo "[+] World-writable files (top 10, REAL FS only):"
    local wf
    wf=$(eval find / $FIND_PRUNE -type f -perm -0002 -printf '%m %u:%g %p\n' 2>/dev/null | head -n 10)
    [ -n "$wf" ] && echo "$wf" || echo "None found."
    echo
    echo "[+] World-writable directories (top 10, REAL FS only):"
    local wd
    wd=$(eval find / $FIND_PRUNE -type d -perm -0002 -printf '%m %u:%g %p\n' 2>/dev/null | head -n 10)
    [ -n "$wd" ] && echo "$wd" || echo "None found."
    echo
    echo "[+] Sticky-bit check (expected 1777 with 't'):"
    for d in /tmp /var/tmp /dev/shm /run/lock /run/screen; do
      [ -e "$d" ] && stat -c "%A %a %U:%G %n" "$d" 2>/dev/null || true
    done
  } >"$T"
