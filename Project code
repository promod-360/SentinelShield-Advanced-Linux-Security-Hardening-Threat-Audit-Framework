# ---------- Hardening ----------
policy_check() {
  ensure_policy
  local T="$TMPDIR/sentinel_policy.txt"
  {
    echo "=== Policy Validation (INI) ==="
    echo "Policy file: $POLICY_FILE"
    echo "Generated: $(date)"
    echo "------------------------------------------------------------"
    echo "$(status_line)"
    echo
    if ! ssh_installed; then
      echo "SSH NOT installed -> SSH checks are N/A"
      echo
      echo "Install to demo hardening:"
      echo "  sudo apt install openssh-server"
      echo "  sudo systemctl enable --now ssh"
    else
      local w_prl w_pa c_prl c_pa
      w_prl=$(ini_get SSH PermitRootLogin "$POLICY_FILE"); [ -z "$w_prl" ] && w_prl=no
      w_pa=$(ini_get SSH PasswordAuthentication "$POLICY_FILE"); [ -z "$w_pa" ] && w_pa=no
      c_prl=$(sshd_get PermitRootLogin); [ -z "$c_prl" ] && c_prl="(not set)"
      c_pa=$(sshd_get PasswordAuthentication); [ -z "$c_pa" ] && c_pa="(not set)"

      echo "Rule: Unset SSH options are NON-COMPLIANT (FAIL)."
      echo
      echo "[+] PermitRootLogin"
      echo "    Current: $c_prl"
      echo "    Policy : $w_prl"
      [ "$(echo "$c_prl"|tr A-Z a-z)" = "$(echo "$w_prl"|tr A-Z a-z)" ] && echo "    => PASS" || echo "    => FAIL"
      echo
      echo "[+] PasswordAuthentication"
      echo "    Current: $c_pa"
      echo "    Policy : $w_pa"
      [ "$(echo "$c_pa"|tr A-Z a-z)" = "$(echo "$w_pa"|tr A-Z a-z)" ] && echo "    => PASS" || echo "    => FAIL"
    fi
  } >"$T"
  log "Hardening: policy check"
  show "Policy Check" "$T"
}

apply_hardening() {
  ensure_policy
  is_root || { msg "Hardening" "Run with sudo to apply hardening."; return; }

  if ! ssh_installed; then
    msg "Hardening" "OpenSSH Server NOT installed.\nHardening is N/A.\n\nInstall:\n  sudo apt install openssh-server\n  sudo systemctl enable --now ssh"
    return
  fi

  confirm "Hardening" "Will update SSH config based on policy.\nBackup will be created.\nProceed?" || return

  local w_prl w_pa bak
  w_prl=$(ini_get SSH PermitRootLogin "$POLICY_FILE"); [ -z "$w_prl" ] && w_prl=no
  w_pa=$(ini_get SSH PasswordAuthentication "$POLICY_FILE"); [ -z "$w_pa" ] && w_pa=no

  bak=$(backup_sshd) || { msg "Hardening" "Backup failed. Aborting."; return; }

  sshd_set PermitRootLogin "$w_prl" || { msg "Hardening" "Failed to set PermitRootLogin"; return; }
  sshd_set PasswordAuthentication "$w_pa" || { msg "Hardening" "Failed to set PasswordAuthentication"; return; }

  if sshd_validate; then
    if ssh_restart; then
      log "Hardening applied. Backup=$bak"
      msg "Hardening" "Hardening applied successfully.\nBackup:\n$bak"
    else
      cp "$bak" "$SSH_CFG" 2>/dev/null || true
      ssh_restart 2>/dev/null || true
      log "Hardening restart failed; rolled back. Backup=$bak"
      msg "Hardening" "SSH restart failed.\nRolled back:\n$bak"
    fi
  else
    cp "$bak" "$SSH_CFG" 2>/dev/null || true
    log "Hardening invalid config; rolled back. Backup=$bak"
    msg "Hardening" "Validation failed (sshd -t).\nRolled back:\n$bak"
  fi
}

rollback() {
  ensure
  is_root || { msg "Rollback" "Run with sudo to rollback."; return; }

  if ! ssh_installed; then
    msg "Rollback" "OpenSSH Server NOT installed.\nRollback is N/A."
    return
  fi

  local b
  b=$(ls -1 "$BACKUP_DIR"/sshd_config.*.bak 2>/dev/null | sort -r | head -n 15 || true)
  [ -z "$b" ] && { msg "Rollback" "No backups found in:\n$BACKUP_DIR"; return; }

  local items=() i=1 f
  while IFS= read -r f; do items+=("$i" "$(basename "$f")"); i=$((i+1)); done <<<"$b"

  local c sel
  c=$(whiptail --title "Rollback" --menu "Select backup to restore:" 22 86 15 "${items[@]}" 3>&1 1>&2 2>&3) || return
  sel=$(echo "$b" | sed -n "${c}p"); [ -z "$sel" ] && return

  confirm "Rollback" "Restore this backup?\n\n$(basename "$sel")" || return
  cp "$sel" "$SSH_CFG" 2>/dev/null || { msg "Rollback" "Restore failed."; return; }
  sshd_validate && ssh_restart 2>/dev/null || true
  log "Rollback restored $sel"
  msg "Rollback" "Restored:\n$sel"
}

hardening_menu() {
