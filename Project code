need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing dependency: $1"; exit 1; }; }
have() { command -v "$1" >/dev/null 2>&1; }
is_root() { [ "$(id -u)" -eq 0 ]; }
ensure() { mkdir -p "$BACKUP_DIR"; touch "$LOGFILE" 2>/dev/null || true; }
log(){ ensure; echo "[$(date '+%F %T')] $*" >> "$LOGFILE"; }

# ---------- small UI helpers ----------
msg() { whiptail --title "$1" --msgbox "$2" 12 86; }
bigmsg() { whiptail --title "$1" --msgbox "$2" 16 92; }
show() { whiptail --title "$1" --scrolltext --textbox "$2" 24 94; }
confirm() { whiptail --title "$1" --yesno "$2" 12 86; }

# ---------- Policy ----------
ensure_policy() {
  ensure
  [ -f "$POLICY_FILE" ] && return
  cat >"$POLICY_FILE"<<'EOF'
[SSH]
PermitRootLogin=no
PasswordAuthentication=no

[SCAN]
MaxWorldWritableFiles=50
MaxWorldWritableDirs=50
EOF
  log "Created policy $POLICY_FILE"
}

ini_get(){ # section key file
  awk -v S="[$1]" -v K="$2" '
    $0~"^[[:space:]]*\\[.*\\][[:space:]]*$"{in=($0==S);next}
    in && $0!~"^[[:space:]]*#" && $0!~"^[[:space:]]*$"{
      split($0,a,"="); k=a[1]; v=a[2]
      gsub(/^[[:space:]]+|[[:space:]]+$/,"",k); gsub(/^[[:space:]]+|[[:space:]]+$/,"",v)
      if(k==K){print v; exit}
    }
  ' "$3"
}

# ---------- SSH detection ----------
ssh_installed() { [ -f "$SSH_CFG" ] || have sshd || [ -x /usr/sbin/sshd ]; }

ssh_service_name() {
  systemctl list-unit-files 2>/dev/null | awk '{print $1}' | grep -qx "ssh.service" && { echo "ssh"; return; }
  systemctl list-unit-files 2>/dev/null | awk '{print $1}' | grep -qx "sshd.service" && { echo "sshd"; return; }
  systemctl is-active ssh 2>/dev/null >/dev/null && { echo "ssh"; return; }
  systemctl is-active sshd 2>/dev/null >/dev/null && { echo "sshd"; return; }
  echo ""
}

ssh_status() {
  local s; s=$(ssh_service_name)
  [ -n "$s" ] && systemctl is-active "$s" 2>/dev/null || echo "NOT FOUND"
}

ssh_restart() {
  local s; s=$(ssh_service_name)
  [ -n "$s" ] || return 1
  systemctl restart "$s" 2>/dev/null
}

sshd_bin() {
  have sshd && { command -v sshd; return; }
  [ -x /usr/sbin/sshd ] && { echo "/usr/sbin/sshd"; return; }
  echo ""
}

sshd_validate() {
  local b; b=$(sshd_bin)
  [ -n "$b" ] || return 1
  "$b" -t 2>/dev/null
}

sshd_get(){ # key -> last value
  [ -f "$SSH_CFG" ] || { echo ""; return; }
  awk -v K="$(echo "$1"|tr A-Z a-z)" '
    $0!~"^[[:space:]]*#" && tolower($1)==K{v=$2}
    END{print v}
  ' "$SSH_CFG"
}

sshd_set(){ # key value
  [ -f "$SSH_CFG" ] || return 1
  local k="$1" v="$2" tmp="$TMPDIR/sshd_config.sentinel.$$"
  awk -v K="$(echo "$k"|tr A-Z a-z)" '
    { if($0~"^[[:space:]]*#"){print; next}
      if(tolower($1)==K) next
      print
    }
  ' "$SSH_CFG" >"$tmp" || return 1
  echo "$k $v" >>"$tmp"
  cp "$tmp" "$SSH_CFG" && rm -f "$tmp"
}

backup_sshd(){
  ensure
  [ -f "$SSH_CFG" ] || return 1
  local ts; ts=$(date +%F_%H-%M-%S)
  cp "$SSH_CFG" "$BACKUP_DIR/sshd_config.$ts.bak" 2>/dev/null || return 1
  echo "$BACKUP_DIR/sshd_config.$ts.bak"
}

